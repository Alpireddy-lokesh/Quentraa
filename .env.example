# QueueLess / Qentra Environment Examples
# -------------------------------
# Never commit real secrets! These are placeholder values only.
# Copy to .env and update for local development or production.

# Database
POSTGRES_DB=queuesless
POSTGRES_USER=queuesless_user
POSTGRES_PASSWORD=queuesless_pass

# Backend Application
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/queuesless
SPRING_DATASOURCE_USERNAME=queuesless_user
SPRING_DATASOURCE_PASSWORD=queuesless_pass

# Server
SERVER_PORT=8080

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Security (placeholders - replace with strong values in production)
# These should be set as environment variables, not committed
APP_JWT_SECRET=your_jwt_secret_key_min_256_bits
APP_JWT_EXPIRATION=3600000  # 1 hour in milliseconds